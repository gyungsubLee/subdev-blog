{
  "name": "second-brain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "prebuild": "npm run check:version && node app/server/scripts/prepare-content.mjs",
    "build": "tsc -b && vite build",
    "check": "npm run check:version && tsc -b && node --test tests/web/*.test.mjs tests/server/*.test.mjs tests/content/*.test.mjs tests/native/*.test.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "export": "node app/content/scripts/export-notion.mjs",
    "import:md": "node app/content/scripts/import-markdown.mjs",
    "predev": "node app/server/scripts/prepare-content.mjs",
    "check:content": "node app/content/scripts/check-content.mjs --check",
    "check:export": "node tests/content/export-check.mjs",
    "check:assets": "node tests/content/export-web-assets.mjs",
    "prepare:assets": "node app/web/scripts/prepare-web-assets.mjs",
    "check:version": "node scripts/check-version.mjs",
    "check:web": "node --test tests/web/*.test.mjs",
    "check:server": "node --test tests/server/*.test.mjs",
    "check:native": "python3 -m unittest discover -s tests/native -p \"test_*.py\"",
    "build:native": "python3 app/native/build.py",
    "export:static": "node app/web/scripts/export-static.mjs"
  },
  "dependencies": {
    "@blocknote/core": "0.56.0",
    "@blocknote/mantine": "0.56.0",
    "@blocknote/react": "0.56.0",
    "@mantine/core": "^8.3.11",
    "@mantine/hooks": "^8.3.11",
    "@shikijs/langs": "^4.5.0",
    "@shikijs/themes": "^4.5.0",
    "katex": "^0.16.47",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.5.0",
    "yaml": "^2.9.1",
    "micromark": "^4.0.3",
    "micromark-util-decode-string": "^2.0.1",
    "parse5": "^7.3.0",
    "entities": "^6.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0"
  }
}
