# Server only. Copy to .env.local; never use VITE_ for these values.
CMS_ORIGIN=http://127.0.0.1:5173
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Generate with: node -e 'process.stdout.write(require("crypto").randomBytes(32).toString("base64url"))'
CMS_SESSION_KEY=
GITHUB_ADMIN_USER_ID=
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_APP_REPOSITORY_ID=
GITHUB_CONTENT_REPOSITORY_ID=
# Application branch must be the repository default branch.
GITHUB_APP_BRANCH=main
GITHUB_CONTENT_BRANCH=main

# Actions-only secrets; do not set these in the web application:
# CMS_APP_ID, CMS_APP_PRIVATE_KEY, VERCEL_TOKEN, VERCEL_ORG_ID, VERCEL_PROJECT_ID
# Actions variables use CMS_ instead of the reserved GITHUB_ prefix.
# CMS_INSTALLATION_ID, CMS_APP_REPOSITORY_ID, CMS_CONTENT_REPOSITORY_ID,
# CMS_APP_BRANCH, CMS_CONTENT_BRANCH, CMS_PREVIEW_ALIAS (optional)
