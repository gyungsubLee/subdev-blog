{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/web",
  "framework": "vite",
  "git": {
    "deploymentEnabled": false
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api?path=:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/notion/assets/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "sandbox; default-src 'none'; style-src 'unsafe-inline'; img-src data:"
        }
      ]
    },
    {
      "source": "/content/assets/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "sandbox; default-src 'none'; style-src 'unsafe-inline'; img-src data:"
        }
      ]
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "app/server/generated/content-catalog.json",
      "excludeFiles": "{content,app/web,app/native,tests,docs}/**",
      "maxDuration": 300
    }
  }
}
